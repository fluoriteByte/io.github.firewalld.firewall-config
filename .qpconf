#!/bin/bash
# shellcheck disable=SC2034
# so that shellcheck shuts the fuck up

APP_ID=io.github.firewalld.firewall-config
MANIFEST=io.github.firewalld.firewall-config.yaml

source_gen() {
  DEPS="meson-python~=0.19.0 patchelf~=0.17.2.4 dbus-python~=1.4.0"
  # shellcheck disable=SC2086
  flatpak-pip-generator $DEPS --runtime=org.gnome.Sdk//50 --prefer-wheels=patchelf -o python-dbus.yaml --yaml 
}
